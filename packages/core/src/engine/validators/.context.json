      "desc": "Shared Zod schemas"
    }
  },
  "rels": {
    "field-schema.ts": [
      "shared-schemas.ts"
    ],
    "form-schema.ts": [
      "field-schema.ts"
    ],
    "grid-schema.ts": [
      "shared-schemas.ts"
    ]
  },
  "extDeps": {
    "field-schema.ts": [
      "zod"
    ],
    "form-schema.ts": [
      "zod"
    ],
    "grid-schema.ts": [
      "zod"
    ],
    "shared-schemas.ts": [
      "zod"
    ]
  }
}

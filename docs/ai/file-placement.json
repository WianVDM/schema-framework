{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "rules": [
    { "when": "New schema type", "put": "packages/core/src/engine/types/", "file": "kebab-case.ts", "update": ["types/index.ts", "validators/", "renderers/field-renderer.tsx"] },
    { "when": "New Zod validator", "put": "packages/core/src/engine/validators/", "file": "kebab-case.ts", "update": ["validators/index.ts"] },
    { "when": "New UI primitive", "put": "packages/core/src/primitives/", "file": "kebab-case.tsx", "update": ["primitives/index.ts", "engine/types/primitive-components.ts", "engine/context/primitives-context.tsx"] },
    { "when": "New renderer", "put": "packages/core/src/engine/renderers/", "file": "kebab-case.tsx", "update": ["renderers/index.ts"] },
    { "when": "New helper/utility", "put": "packages/core/src/engine/helpers/", "file": "kebab-case.ts", "update": ["helpers/index.ts"] },
    { "when": "New showcase route", "put": "apps/showcase/src/routes/", "file": "kebab-case.tsx", "update": [] },
    { "when": "New mock schema", "put": "apps/showcase/src/data/", "file": "kebab-case.ts", "update": ["data/index.ts", "server/"] },
    { "when": "New server function", "put": "apps/showcase/src/server/", "file": "get-kebab-case.ts", "update": [] }
  ]
}
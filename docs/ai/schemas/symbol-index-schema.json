{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "$id": "symbol-index-schema.json",
  "title": "Symbol Index",
  "description": "Master lookup of all public exports across the codebase",
  "type": "object",
  "required": ["$schema", "symbols"],
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string",
      "description": "Relative path to this schema file"
    },
    "symbols": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["file", "type", "layer"],
        "additionalProperties": false,
        "properties": {
          "file": {
            "type": "string",
            "description": "Relative file path from monorepo root"
          },
          "type": {
            "type": "string",
            "enum": ["interface", "type", "function", "const", "component"],
            "description": "Export type classification"
          },
          "layer": {
            "type": "integer",
            "minimum": 1,
            "maximum": 3
          }
        }
      }
    }
  }
}
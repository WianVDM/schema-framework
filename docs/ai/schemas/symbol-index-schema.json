{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "$id": "symbol-index-schema.json",
  "title": "Symbol Index (Per-Layer)",
  "description": "Schema for per-layer symbol index files. Symbols use array format for collision handling.",
  "type": "object",
  "required": ["$schema", "layer", "generatedAt", "symbols"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "layer": { "type": "integer", "minimum": 1, "maximum": 3 },
    "generatedAt": { "type": "string", "format": "date-time" },
    "symbols": {
      "type": "object",
      "description": "Map of export name → array of locations (handles name collisions)",
      "additionalProperties": {
        "type": "array",
        "items": {
          "type": "object",
          "required": ["file", "type", "category"],
          "additionalProperties": false,
          "properties": {
            "file": { "type": "string", "description": "Relative file path from project root" },
            "type": {
              "type": "string",
              "enum": ["interface", "type", "function", "const", "component", "utility", "config"]
            },
            "category": {
              "type": "string",
              "enum": ["dto", "component", "utility", "controller", "service", "config", "other"]
            }
          }
        }
      }
    }
  }
}

{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "$id": "directory-index-schema.json",
  "title": "Directory Index",
  "description": "Schema for docs/ai/directory-index.json — directory to purpose one-liner map",
  "type": "object",
  "required": ["$schema", "generatedAt", "directories"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string", "description": "Relative path to this schema file" },
    "generatedAt": { "type": "string", "format": "date-time", "description": "ISO 8601 timestamp of generation" },
    "directories": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "description": "Purpose statement for this directory"
      }
    }
  }
}
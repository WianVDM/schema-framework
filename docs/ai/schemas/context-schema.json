{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "$id": "context-schema.json",
  "title": "Directory Context",
  "description": "Schema for .context.json files that document directory contents and relationships",
  "type": "object",
  "required": [
    "$schema",
    "layer",
    "language",
    "purpose",
    "files"
  ],
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string",
      "description": "Relative path to this schema file"
    },
    "layer": {
      "type": "integer",
      "minimum": 1,
      "maximum": 3,
      "description": "Architecture layer: 1=Primitives, 2=Engine, 3=Composition"
    },
    "language": {
      "type": "string",
      "description": "Primary language of source files in this directory",
      "enum": [
        "typescript",
        "typescript-jsx",
        "javascript",
        "json",
        "markdown"
      ]
    },
    "purpose": {
      "type": "string",
      "maxLength": 120,
      "description": "Brief purpose statement for this directory"
    },
    "files": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": [
          "export",
          "type",
          "desc"
        ],
        "additionalProperties": false,
        "properties": {
          "export": {
            "type": "string",
            "description": "Primary export name, or comma-separated for multi-export files"
          },
          "type": {
            "type": "string",
            "enum": [
              "interface",
              "type",
              "function",
              "const",
              "component",
              "re-export",
              "utility",
              "config"
            ],
            "description": "Export type classification"
          },
          "desc": {
            "type": "string",
            "maxLength": 60,
            "description": "Brief description (max 8 words)"
          },
          "deprecated": {
            "type": "boolean",
            "description": "Whether this file's export is deprecated"
          },
          "tests": {
            "type": "string",
            "description": "Repo-relative path to the test file for this source file",
            "pattern": "^(?!/)(?!https?://).+$"
          },
          "internalRefs": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "AST-level: types/interfaces referenced within this file (optional deep mode)"
          }
        }
      }
    },
    "rels": {
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "items": {
          "type": "object",
          "required": [
            "path"
          ],
          "additionalProperties": false,
          "properties": {
            "path": {
              "type": "string"
            },
            "confidence": {
              "type": "string",
              "enum": [
                "explicit",
                "inferred"
              ],
              "default": "explicit"
            }
          }
        },
        "description": "Internal file dependencies within this directory"
      },
      "description": "Internal relationship map"
    },
    "extDeps": {
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "items": {
          "type": "object",
          "required": [
            "path"
          ],
          "additionalProperties": false,
          "properties": {
            "path": {
              "type": "string"
            },
            "confidence": {
              "type": "string",
              "enum": [
                "explicit",
                "inferred"
              ],
              "default": "explicit"
            }
          }
        },
        "description": "External import paths outside this directory"
      },
      "description": "External dependency map"
    },
    "governance": {
      "type": "object",
      "description": "Directory-level governance constraints. Auto-generated with TODO markers for manual fields.",
      "additionalProperties": false,
      "properties": {
        "importsFrom": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true,
          "description": "Allowed import sources as glob patterns relative to project root. Empty array = unrestricted."
        },
        "importedBy": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true,
          "description": "Allowed consumer directories as glob patterns. Empty array = unrestricted."
        },
        "constraints": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true,
          "description": "Human-readable constraint statements extracted from directory READMEs."
        },
        "forbidden": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true,
          "description": "Forbidden import targets as glob patterns. Blocks importing from these paths."
        },
        "inherits": {
          "type": "boolean",
          "default": true,
          "description": "Whether to inherit unset governance fields from parent .context.json. Default true."
        }
      }
    }
  }
}
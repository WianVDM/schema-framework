{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "$id": "flows-schema.json",
  "title": "Flow Context",
  "description": "Schema for docs/ai/flows.json — key data/request flows through the system",
  "type": "object",
  "required": ["$schema", "flows"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string", "description": "Relative path to this schema file" },
    "flows": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["trigger", "steps"],
        "additionalProperties": false,
        "properties": {
          "trigger": { "type": "string", "maxLength": 100, "description": "What initiates this flow" },
          "steps": {
            "type": "array",
            "items": { "type": "string" },
            "description": "Ordered list: 'file/path → MethodOrFunction' per step"
          },
          "touches": {
            "type": "array",
            "items": { "type": "string" },
            "description": "Side effects: database tables, queues, external APIs, caches"
          },
          "errorPath": {
            "type": "string",
            "maxLength": 200,
            "description": "What happens on failure — exception type, retry behavior, fallback"
          }
        }
      }
    }
  }
}
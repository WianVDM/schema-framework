{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "$id": "config-schema-schema.json",
  "title": "Configuration Schema",
  "description": "Schema for docs/ai/config-schema.json — configuration shape without secrets",
  "type": "object",
  "required": ["$schema", "sections"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string", "description": "Relative path to this schema file" },
    "sections": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["keys"],
        "additionalProperties": false,
        "properties": {
          "keys": {
            "type": "object",
            "additionalProperties": {
              "type": "object",
              "required": ["type", "consumedBy"],
              "additionalProperties": false,
              "properties": {
                "type": { "type": "string", "description": "Value type: string, boolean, integer, etc." },
                "consumedBy": { "type": "string", "description": "Which layer/service consumes this key" },
                "perTenant": { "type": "boolean", "default": false, "description": "Whether this key varies per tenant" }
              }
            }
          }
        }
      }
    }
  }
}
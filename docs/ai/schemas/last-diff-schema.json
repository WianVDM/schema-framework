{
    "$schema": "https://json-schema.org/draft-07/schema#",
    "$id": "last-diff-schema.json",
    "title": "Last Diff",
    "description": "What changed since last context generation. $schema is required in every instance for self-description (all generated Tier 2 artifacts include it)",
    "type": "object",
    "required": [
        "$schema",
        "generatedAt",
        "added",
        "removed",
        "modified",
        "summary"
    ],
    "additionalProperties": false,
    "properties": {
        "$schema": {
            "type": "string"
        },
        "generatedAt": {
            "type": "string",
            "format": "date-time"
        },
        "added": {
            "type": "array",
            "items": {
                "type": "string"
            }
        },
        "removed": {
            "type": "array",
            "items": {
                "type": "string"
            }
        },
        "modified": {
            "type": "array",
            "items": {
                "type": "string"
            }
        },
        "summary": {
            "type": "string"
        }
    }
}
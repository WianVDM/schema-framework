{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "$id": "impact-graph-schema.json",
  "title": "Change Impact Graph",
  "description": "Schema for docs/ai/impact-graph.json — reverse dependency lookup (inverted extDeps)",
  "type": "object",
  "required": ["$schema", "generatedAt", "impacts"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string", "description": "Relative path to this schema file" },
    "generatedAt": {
      "type": "string",
      "format": "date-time",
      "description": "ISO 8601 timestamp of generation"
    },
    "impacts": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["consumedBy"],
        "additionalProperties": false,
        "properties": {
          "consumedBy": {
            "type": "array",
            "items": { "type": "string" },
            "description": "Files/directories that import or depend on this export"
          }
        }
      }
    }
  }
}

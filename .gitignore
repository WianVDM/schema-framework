# Dependencies
node_modules/

# Build outputs
dist/
.turbo/
.vinxi/
.output/

# Environment & secrets
.env
.env.*

# Logs
*.log

# OS files
.DS_Store
Thumbs.db

# TypeScript build cache
*.tsbuildinfo

# AI-specific rules, hooks, and workflows
.clinerules/
.agents/
.agent/
AGENTS.md

# AI context — auto-generated by scripts/generate-ai-context/ at build time
.ai/context/*.json
.ai/context/*.md
.ai/context/schemas/
**/.context.json

# AI memory — session state and knowledge graph (track schemas, ignore data)
.ai/memory/store.json
.ai/memory/decisions.json
.ai/memory/.session-active

# AI decisions — track ADR markdown files
# NOTE: .ai/decisions/ IS tracked in git (intentional)

# Docs — implementation plans are ephemeral working documents, not tracked
docs/plans/
docs/**/*.tmp

# Editor settings — personal/IDE-specific
.vscode/
.idea/


# Dev utility scripts — AI/tooling internals (not required to build/run)
scripts/auto-changeset/
scripts/ci-check/
scripts/compliance-check/
scripts/generate-ai-context/
scripts/shared/
# NOTE: scripts/version-packages.mjs and sync-version-status.mjs are tracked — used by release.yml

# Auto-generated runtime files
**/.tanstack/

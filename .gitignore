# Dependencies
node_modules/

# Build outputs
dist/
.turbo/
.vinxi/
.output/

# Environment & secrets
.env
.env.*

# Logs
*.log

# OS files
.DS_Store
Thumbs.db
$null

# TypeScript build cache
*.tsbuildinfo

# AI-specific rules, hooks, and workflows
.clinerules/
.agent/
AGENTS.md

# Docs — implementation plans are ephemeral working documents, not tracked
docs/plans/
docs/**/*.tmp

# AI context — auto-generated by scripts/generate-ai-context/ at build time
# Tier 1: per-directory context maps (regenerate on every build)
**/.context.json
# Tier 2: aggregated symbol indexes, graphs, and analysis
docs/ai/symbol-index-*.json
docs/ai/impact-graph.json
docs/ai/directory-index.json
docs/ai/community-map.json
docs/ai/core-abstractions.json
docs/ai/insights.json
docs/ai/last-diff.json
docs/ai/.last-state.json
# Tier 3: auto-generated documentation
docs/context-map.md

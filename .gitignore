# Dependencies
node_modules/

# Build outputs
dist/
.turbo/
.vinxi/
.output/

# Environment & secrets
.env
.env.*

# Logs
*.log

# OS files
.DS_Store
Thumbs.db
$null

# TypeScript build cache
*.tsbuildinfo

# AI-specific rules, hooks, and workflows
.clinerules/
.agents/
.agent/
AGENTS.md

# AI context — auto-generated by scripts/generate-ai-context/ at build time
docs/ai/
**/.context.json
docs/context-map.md

# Docs — implementation plans are ephemeral working documents, not tracked
docs/plans/
docs/**/*.tmp

# Editor settings — personal/IDE-specific
.vscode/
.idea/


# Dev utility scripts — AI/tooling internals (not required to build/run)
scripts/auto-changeset/
scripts/ci-check/
scripts/compliance-check/
scripts/generate-ai-context/
scripts/shared/
# NOTE: scripts/version-packages.mjs and sync-version-status.mjs are tracked — used by release.yml

# Auto-generated runtime files
**/.tanstack/

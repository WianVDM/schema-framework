{
  "json.schemas": [
    {
      "fileMatch": ["**/.context.json"],
      "url": "./docs/ai/schemas/context-schema.json"
    },
    {
      "fileMatch": ["docs/ai/symbol-index.json"],
      "url": "./docs/ai/schemas/symbol-index-schema.json"
    }
  ],
  "better-comments.tags": [
    {
      "tag": "TODO:",
      "color": "#FFFFFF",
      "backgroundColor": "#FFBD2A",
      "strikethrough": false,
      "underline": false,
      "bold": true,
      "italic": false
    },
    {
      "tag": "FIXME:",
      "color": "#FFFFFF",
      "backgroundColor": "#FF2D00",
      "strikethrough": false,
      "underline": false,
      "bold": true,
      "italic": false
    },
    {
      "tag": "WARNING:",
      "color": "#FFFFFF",
      "backgroundColor": "#D43900",
      "strikethrough": false,
      "underline": false,
      "bold": true,
      "italic": false
    },
    {
      "tag": "NOTE:",
      "color": "#3498DB",
      "backgroundColor": "transparent",
      "strikethrough": false,
      "underline": false,
      "bold": false,
      "italic": false
    },
    {
      "tag": "HACK:",
      "color": "#000000",
      "backgroundColor": "#FFC107",
      "strikethrough": false,
      "underline": false,
      "bold": true,
      "italic": false
    },
    {
      "tag": "?",
      "color": "#3498DB",
      "backgroundColor": "transparent",
      "strikethrough": false,
      "underline": false,
      "bold": false,
      "italic": true
    },
    {
      "tag": "!",
      "color": "#FFFFFF",
      "backgroundColor": "#C0392B",
      "strikethrough": false,
      "underline": false,
      "bold": true,
      "italic": false
    }
  ]
}
